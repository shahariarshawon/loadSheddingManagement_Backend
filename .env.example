# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridwatch_db?schema=public

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Credentials (GCP)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# CORS Allowed Origins
CLIENT_URL=http://localhost:3000

# Initial Admin Credentials (for database seeding)
ADMIN_EMAIL=admin@gridwatch.com
ADMIN_PASSWORD=Admin123!Secure
ADMIN_NAME=System Administrator
ADMIN_PHONE=+8801700000000
