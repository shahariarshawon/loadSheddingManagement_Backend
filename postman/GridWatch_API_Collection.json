            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tariq Rahman\",\n  \"email\": \"tariq@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phone\": \"+8801700000001\"\n}"
            }
          }
        },
        {
          "name": "Login Customer",
