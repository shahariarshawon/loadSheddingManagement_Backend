{
  "info": {
    "name": "GridWatch API - Load Shedding & Power Management System",
    "_postman_id": "a987d6e5-4321-4fba-b123-9876543210ab",
    "description": "Comprehensive Postman collection for GridWatch REST API covering Auth, RBAC, Distribution Network, and Planned Load Shedding Outages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "operatorToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health & Server",
      "item": [
        {
          "name": "Health Check (DB Verification)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
