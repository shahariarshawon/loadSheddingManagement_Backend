{
  "name": "gridwatch-api",
  "version": "1.0.0",
  "description": "GridWatch - Load Shedding & Power Management System REST API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup src/server.ts --format esm --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-runner.ts",
    "lint": "eslint src",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^23.1.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/config": "7.10.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.72.2"
  }
}
